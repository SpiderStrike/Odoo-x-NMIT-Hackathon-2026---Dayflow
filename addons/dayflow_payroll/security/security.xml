<odoo>
    <record id="rule_salary_hr_only" model="ir.rule">
        <field name="name">Salary structures HR only</field>
        <field name="model_id" ref="model_dayflow_salary_structure"/>
        <field name="groups" eval="[(4, ref('dayflow_core.group_dayflow_hr'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_payroll_hr_only" model="ir.rule">
        <field name="name">Payroll HR only</field>
        <field name="model_id" ref="model_dayflow_payroll"/>
        <field name="groups" eval="[(4, ref('dayflow_core.group_dayflow_hr'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
