<odoo>
    <record id="view_dayflow_payroll_list" model="ir.ui.view">
        <field name="name">dayflow.payroll.list</field>
        <field name="model">dayflow.payroll</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="calendar_days"/>
                <field name="unpaid_leave_days"/>
                <field name="payable_days"/>
                <field name="gross_salary"/>
                <field name="net_salary"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_dayflow_payroll_form" model="ir.ui.view">
        <field name="name">dayflow.payroll.form</field>
        <field name="model">dayflow.payroll</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="salary_structure_id"/>
                        <field name="period_start"/>
                        <field name="period_end"/>
                        <field name="calendar_days"/>
                        <field name="unpaid_leave_days"/>
                        <field name="payable_days"/>
                    </group>
                    <group>
                        <field name="gross_salary"/>
                        <field name="pf"/>
                        <field name="professional_tax"/>
                        <field name="net_salary"/>
                        <field name="state"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_dayflow_payroll" model="ir.actions.act_window">
        <field name="name">Payroll</field>
        <field name="res_model">dayflow.payroll</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
