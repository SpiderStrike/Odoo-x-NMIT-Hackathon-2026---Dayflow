<odoo>
    <record id="rule_leave_employee_own" model="ir.rule">
        <field name="name">Employee sees own leave</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="groups" eval="[(4, ref('dayflow_core.group_dayflow_employee'))]"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_leave_hr_all" model="ir.rule">
        <field name="name">HR sees all leave</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="groups" eval="[(4, ref('dayflow_core.group_dayflow_hr'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
