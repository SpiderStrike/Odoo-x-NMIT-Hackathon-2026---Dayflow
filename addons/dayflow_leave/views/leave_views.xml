<odoo>
    <record id="view_dayflow_leave_form" model="ir.ui.view">
        <field name="name">dayflow.leave.form</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="dayflow_leave_type"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="dayflow_hr_comment"/>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="dayflow_medical_certificate"
                       filename="dayflow_medical_certificate_name"
                       invisible="dayflow_leave_type != 'sick'"/>
                <field name="dayflow_medical_certificate_name" invisible="1"/>
            </xpath>
        </field>
    </record>
    <record id="view_dayflow_leave_list" model="ir.ui.view">
        <field name="name">dayflow.leave.list</field>
        <field name="model">hr.leave</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="holiday_status_id"/>
                <field name="dayflow_leave_type"/>
                <field name="request_date_from"/>
                <field name="request_date_to"/>
                <field name="number_of_days"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <record id="action_dayflow_leave" model="ir.actions.act_window">
        <field name="name">Leave Requests</field>
        <field name="res_model">hr.leave</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_dayflow_leave_list"/>
    </record>
</odoo>
